@using QuickMath.Shared.Services
@inject IAccountManagerService AccountManager
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">QuickMath</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="play">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
                Play
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link account-nav-link" href="account" title="Account">
                
                @if (AccountManager.State == AccountState.SignedIn &&
                     !string.IsNullOrEmpty(AccountManager.CurrentUser?.PhotoUrl))
                {
                    <img class="nav-profile-picture"
                         src="@AccountManager.CurrentUser.PhotoUrl"
                         alt="Account" />
                }
                else
                {
                    <span class="bi bi-person-circle nav-profile-fallback"
                          aria-hidden="true"></span>
                }
                <label>  account</label>
            </NavLink>
        </div>

    </nav>
</div>
