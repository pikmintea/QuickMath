@page "/login"
@inject NavigationManager Navigation
@inject IAccountManagerService AccountManager
@using QuickMath.Shared.Services
@inject IGoogleAuthService GoogleAuth
<form action="" class="form">
    <p>
        Welcome,<span>sign in to continue</span>
    </p>
    <button @onclick="SignInWithGoogle"  class="oauthButton">
        <svg class="icon" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
            <path d="M1 1h22v22H1z" fill="none"></path>
        </svg>
        Continue with Google
    </button>
    <button class="oauthButton guest" @onclick="PlayAsGuest">
        Continue as a guest
    </button>
</form>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap');

    .form {
        position: relative;
        z-index: 1;
        background: #FFFFFF;
        padding: 36px 32px;
        border-radius: 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        width: 300px;
        margin: 60px auto;
        box-shadow: 0 12px 0 #E4DFFA, 0 20px 40px rgba(108, 92, 231, 0.18);
        border: 3px solid #2D2D3A;
        font-family: 'Nunito Sans', sans-serif;
    }

    .form > p {
        text-align: center;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .form > p::before {
            content: "Welcome to QuickMath";
            font-family: 'Baloo 2', sans-serif;
            font-weight: 800;
            font-size: 26px;
            color: #2D2D3A;
        }

        .form > p > span {
            font-size: 15px;
            color: #8B87A3;
            font-weight: 600;
        }

    .oauthButton {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        width: 100%;
        height: 52px;
        border-radius: 16px;
        border: 3px solid #2D2D3A;
        font-family: 'Nunito Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 120ms ease, box-shadow 120ms ease;
        box-sizing: border-box;
    }

        .oauthButton.google {
            background: #FFFFFF;
            color: #2D2D3A;
            box-shadow: 0 6px 0 #2D2D3A;
        }

            .oauthButton.google:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 0 #2D2D3A;
            }

            .oauthButton.google:active {
                transform: translateY(4px);
                box-shadow: 0 2px 0 #2D2D3A;
            }

        .oauthButton.guest {
            background: #FFC93C;
            color: #2D2D3A;
            box-shadow: 0 6px 0 #C99A1F;
        }

            .oauthButton.guest:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 0 #C99A1F;
            }

            .oauthButton.guest:active {
                transform: translateY(4px);
                box-shadow: 0 2px 0 #C99A1F;
            }

    .icon {
        width: 22px;
        height: 22px;
    }
</style>

@code {

    private async Task SignInWithGoogle()
    {
        var profile = await GoogleAuth.SignInToFirebaseAsync();
        if (profile != null)
        {
            AccountManager.SetSignedIn(profile);
            Navigation.NavigateTo("/play");
        }
    }

    private void PlayAsGuest()
    {
        AccountManager.SetGuest();
        Navigation.NavigateTo("/play");
    }

}