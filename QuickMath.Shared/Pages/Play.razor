@page "/play"
@using QuickMath.Shared.Services
@using QuickMath.Shared.Models
@inject IExerciseGenerator ExerciseGenerator

<PageTitle>Play</PageTitle>

@if (current != null)
{
    <div class="play-page">
        <div class="floaters">
            <span style="top:8%; left:6%; font-size:120px;">+</span>
            <span style="top:70%; left:4%; font-size:90px; animation-delay:3s;">÷</span>
            <span style="top:12%; left:88%; font-size:100px; animation-delay:5s;">×</span>
            <span style="top:78%; left:86%; font-size:110px; animation-delay:2s;">=</span>
            <span style="top:45%; left:2%; font-size:70px; animation-delay:7s;">7</span>
            <span style="top:40%; left:94%; font-size:80px; animation-delay:4s;">−</span>
        </div>

        <div class="switch">
            <select class="dropdown" @bind="selectedOperation" >
                <option  value="addition">addition</option>
                <option value="subtraction">subtraction</option>
            </select>
            <select class="dropdown" @bind="selectedDifficulty" >
                <option  value="easy++">easy++</option>
                <option  value="easy">easy</option>
                <option  value="medium">medium</option>
            </select>
        </div>

        <div class="corner-stat top-right">
            <span class="corner-stat-num"> @streak</span>
            <span class="corner-stat-label">Streak</span>
        </div>
        <div class="corner-stat top-right-2">
            <span class="corner-stat-num">@answeredCount</span>
            <span class="corner-stat-label">Answered</span>
        </div>

        <div class="stage @stageState">
            <div class="question-text">@current.QuestionText</div>
            <input class="answer-input @cardState"
                   value="@answerInput"
                   @oninput="OnAnswerChanged"
                   inputmode="numeric"
                   autocomplete="off"
                   placeholder="?" />
            <div class="feedback-msg @cardState @(feedback != "" ? "show" : "")">@feedback</div>
        </div>

        <div class="hint">Type your answer — it checks automatically</div>
    </div>
}

@code {
    private Exercise? current;
    private string answerInput = "";
    private string cardState = "";
    private string stageState = "";
    private string feedback = "";
    private int streak = 0;
    private int answeredCount = 0;
    private int correctCount = 0;
    private bool isProcessing = false;

    public string selectedOperation = "addition";
    public string selectedDifficulty = "easy++";
    protected override void OnInitialized()
    {
        NextQuestion();
    }

    private void NextQuestion()
    {
        if (selectedOperation == "addition")
        {
            ExerciseGenerator.SetDifficulty(selectedDifficulty);
            current = ExerciseGenerator.NextAddition();
        }
        else if (selectedOperation == "subtraction")
        {
            ExerciseGenerator.SetDifficulty(selectedDifficulty);
            current = ExerciseGenerator.NextSubtraction();
        }
        else
        {
            cardState = "Select an operation"; 
        }
        answerInput = "";
        cardState = "";
        stageState = "";
        feedback = "";
        isProcessing = false;
    }


    private async Task OnAnswerChanged(ChangeEventArgs e)
    {
        if (isProcessing || current == null)
        {
            return;
        }

        answerInput = e.Value?.ToString() ?? "";

        var expectedLength = current.CorrectAnswer.ToString().Length;
        if (answerInput.Length < expectedLength)
        {
            return;
        }

        isProcessing = true;

        if (int.TryParse(answerInput, out var val) && val == current.CorrectAnswer)
        {
            cardState = "correct";
            feedback = "Correct!";
            streak++;
            answeredCount++;
            correctCount++;
            StateHasChanged();
            await Task.Delay(650);
        }
        else
        {
            cardState = "wrong";
            stageState = "wrong";
            feedback = $"Answer: {current.CorrectAnswer}";
            streak = 0;
            answeredCount++;
            StateHasChanged();
            await Task.Delay(850);
        }

        NextQuestion();
        StateHasChanged();
    }

    private double Accuracy => answeredCount == 0 ? 0 : (double)correctCount / answeredCount * 100;
}
