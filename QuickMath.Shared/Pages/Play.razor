@page "/play"
@using QuickMath.Shared.Services
@using QuickMath.Shared.Models
@inject IExerciseGenerator ExerciseGenerator

<PageTitle>Play</PageTitle>

@if (current != null)
{
    <div class="play-wrap">
        <div class="top-row">
            <span class="streak-pill">Streak: @streak</span>
            <span class="answered-pill">Answered: @answeredCount</span>
        </div>

        <div class="question-card @cardState">
            <div class="question-text">@current.QuestionText</div>
            <input class="answer-input @cardState"
                   value="@answerInput"
                   @oninput="OnAnswerChanged"
                   inputmode="numeric"
                   autocomplete="off" />
            <div class="feedback-msg @cardState">@feedback</div>
        </div>

        <div class="hint">Type your answer — it checks automatically, no button needed</div>
    </div>
}

<style>
    .play-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        max-width: 380px;
        margin: 32px auto;
        font-family: 'Nunito Sans', sans-serif;
    }

    .top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .streak-pill, .answered-pill {
        font-family: 'Baloo 2', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #2D2D3A;
    }

    .answered-pill {
        color: #8B87A3;
        font-size: 13px;
    }

    .question-card {
        background: #FFFFFF;
        border: 3px solid #2D2D3A;
        border-radius: 28px;
        padding: 48px 40px;
        width: 100%;
        text-align: center;
        box-shadow: 0 10px 0 #E4DFFA;
        transition: box-shadow 150ms ease, border-color 150ms ease;
    }

        .question-card.correct {
            box-shadow: 0 10px 0 #1F9C57;
            border-color: #2ECC71;
        }

        .question-card.wrong {
            box-shadow: 0 10px 0 #B03A2E;
            border-color: #E74C3C;
            animation: shake 300ms ease;
        }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-8px);
        }

        75% {
            transform: translateX(8px);
        }
    }

    .question-text {
        font-family: 'Baloo 2', sans-serif;
        font-size: 44px;
        font-weight: 800;
        margin-bottom: 28px;
        color: #2D2D3A;
    }

    .answer-input {
        width: 140px;
        height: 64px;
        text-align: center;
        font-family: 'Baloo 2', sans-serif;
        font-size: 30px;
        font-weight: 700;
        border: 3px solid #2D2D3A;
        border-radius: 18px;
        outline: none;
    }

        .answer-input.correct {
            border-color: #2ECC71;
            background: #EAFBF1;
            color: #1F9C57;
        }

        .answer-input.wrong {
            border-color: #E74C3C;
            background: #FDECEA;
            color: #B03A2E;
        }

    .feedback-msg {
        margin-top: 18px;
        font-family: 'Baloo 2', sans-serif;
        font-weight: 700;
        font-size: 16px;
        height: 22px;
    }

        .feedback-msg.correct {
            color: #2ECC71;
        }

        .feedback-msg.wrong {
            color: #E74C3C;
        }

    .hint {
        font-size: 13px;
        color: #8B87A3;
        font-weight: 600;
        text-align: center;
    }
</style>

@code {
    private Exercise? current;
    private string answerInput = "";
    private string cardState = "";
    private string feedback = "";
    private int streak = 0;
    private int answeredCount = 0;
    private bool isProcessing = false;

    protected override void OnInitialized()
    {
        NextQuestion();
    }

    private void NextQuestion()
    {
        current = ExerciseGenerator.NextAddition();
        answerInput = "";
        cardState = "";
        feedback = "";
        isProcessing = false;
    }

    private async Task OnAnswerChanged(ChangeEventArgs e)
    {
        if (isProcessing || current == null)
        {
            return;
        }

        answerInput = e.Value?.ToString() ?? "";

        var expectedLength = current.CorrectAnswer.ToString().Length;
        if (answerInput.Length < expectedLength)
        {
            return;
        }

        isProcessing = true;

        if (int.TryParse(answerInput, out var val) && val == current.CorrectAnswer)
        {
            cardState = "correct";
            feedback = "Correct!";
            streak++;
            answeredCount++;
            StateHasChanged();
            await Task.Delay(700);
        }
        else
        {
            cardState = "wrong";
            feedback = $"Answer: {current.CorrectAnswer}";
            streak = 0;
            answeredCount++;
            StateHasChanged();
            await Task.Delay(900);
        }

        NextQuestion();
        StateHasChanged();
    }
}
