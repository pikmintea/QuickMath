@page "/account"
@using QuickMath.Shared.Services
@inject IAccountManagerService AccountManager
@inject NavigationManager Navigation

<PageTitle>Account</PageTitle>



@if (AccountManager.State == AccountState.SignedIn && AccountManager.CurrentUser is { } user)
{
    <div class="account-card">
        @if (!string.IsNullOrEmpty(user.PhotoUrl))
        {
            <img src="@user.PhotoUrl" alt="Profile picture" class="avatar" />
        }
        else
        {
            <div class="avatar avatar-fallback">
                @(string.IsNullOrEmpty(user.DisplayName) ? "?" : user.DisplayName[0].ToString().ToUpper())
            </div>
        }

        <div class="account-info">
            <strong>@(user.DisplayName ?? "QuickMath player")</strong>
            <span>@user.Email</span>
        </div>

        <button class="signout-btn" @onclick="SignOut">Sign out</button>
    </div>
}



@code {
    private void SignOut()
    {
        AccountManager.SetGuest();
        Navigation.NavigateTo("/login");
    }

    private void GoToSignIn()
    {
        Navigation.NavigateTo("/login");
    }

    private void ClearDataForTesting()
    {
        AccountManager.ClearAllData();
        Navigation.NavigateTo("/login");
    }

}
