@page "/"
@using QuickMath.Shared.Services
@inject IFormFactor FormFactor
@inject IAccountManagerService AccountManager
@inject NavigationManager Navigation
<PageTitle>Home</PageTitle>
@if (AccountManager.State == AccountState.SignedIn)
{
    <div class="home-page">
        <h1>Welcome, @AccountManager.CurrentUser?.DisplayName!</h1>
        <p>You're signed in. Enjoy your experience!</p>
    </div>
}




@code {


    


    void GoToSignIn()
    {
        Navigation.NavigateTo("/login");
    }
 

}
