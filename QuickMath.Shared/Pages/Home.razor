@page "/"
@using QuickMath.Shared.Services
@inject IFormFactor FormFactor
@inject IAccountManagerService AccountManager
@inject NavigationManager Navigation
<PageTitle>Home</PageTitle>

@if (AccountManager.State == AccountState.Guest)
{
    <div class="guest-banner">
        <div class="guest-banner-text">
            <strong>You're playing as a guest</strong>
            <span>Progress is saved on this device only</span>
        </div>
        <button class="guest-banner-btn" @onclick="GoToSignIn">
            <svg class="icon" viewBox="0 0 24 24">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
            </svg>
            Sign in to sync
        </button>
    </div>
}
<style>
    .guest-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: #FFF7DE;
        border: 3px solid #2D2D3A;
        border-radius: 20px;
        padding: 16px 20px;
        margin-bottom: 24px;
        box-shadow: 0 6px 0 #F0D98C;
        flex-wrap: wrap;
    }

    .guest-banner-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-family: 'Nunito Sans', sans-serif;
    }

        .guest-banner-text strong {
            font-family: 'Baloo 2', sans-serif;
            font-size: 17px;
            color: #2D2D3A;
        }

        .guest-banner-text span {
            font-size: 14px;
            color: #8B87A3;
            font-weight: 600;
        }

    .guest-banner-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #FFFFFF;
        border: 3px solid #2D2D3A;
        border-radius: 14px;
        padding: 10px 18px;
        font-family: 'Nunito Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #2D2D3A;
        cursor: pointer;
        box-shadow: 0 5px 0 #2D2D3A;
        transition: transform 120ms ease, box-shadow 120ms ease;
        white-space: nowrap;
    }

        .guest-banner-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 0 #2D2D3A;
        }

        .guest-banner-btn:active {
            transform: translateY(3px);
            box-shadow: 0 2px 0 #2D2D3A;
        }

    .icon {
        width: 18px;
        height: 18px;
    }
</style> 
<h1>Hello, world!</h1>

Welcome to your new app running on <em>@factor</em> using <em>@platform</em>.

@code {
    private string factor => FormFactor.GetFormFactor();
    private string platform => FormFactor.GetPlatform();

    private void GoToSignIn()
    {
        Navigation.NavigateTo("/login");
    }
}